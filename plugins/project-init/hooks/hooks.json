{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/federated-context-preflight.py\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\federated-context-preflight.py\"",
            "timeout": 5,
            "statusMessage": "Loading MoxyWolf federated context contract..."
          }
        ]
      }
    ]
  }
}
